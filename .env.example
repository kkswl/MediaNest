# Local synthetic development only. Never put real cookies in this file.
DATABASE_URL=sqlite:///data/yingji.db
# Set a persistent random secret with at least 32 characters before real use.
# If omitted, local startup creates data/app-secret; back it up with the database.
APP_SECRET=
ENABLE_LIVE_115=no
# Default live safety gate: root only, at most two directory requests per job.
LIVE_ROOT_ONLY=yes
ENABLE_TMDB=no
TMDB_TOKEN=
STATE_DIR=data
# Empty by default. Only manually audited credential-free source image hosts.
PUBLIC_SOURCE_IMAGE_HOSTS=
FAILURE_THRESHOLD=3
SCAN_PAGE_SIZE=50
REQUEST_INTERVAL=2
